<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>ru.kazantsev.nsmp.sdk.intellij_plugin</id>
    <name>NSMP SDK</name>
    <vendor email="exeki@yandex.ru">Kazantsev Egor</vendor>
    <description><![CDATA[
        Plugin to simplify development in the Naumen Service Management Platform environment.
        It contains functions for working with the platform's sources in a git-like form.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.intellij.groovy</depends>

    <resource-bundle>messages.MessageBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="NSMP SDK Notifications" displayType="BALLOON" isLogByDefault="true"/>
        <postStartupActivity implementation="ru.kazantsev.nsmp.sdk.intellij_plugin.startup.PluginStartup"/>
        <toolWindow id="NSMP SDK"
                    anchor="right"
                    icon="/icons/logo/stripe/nsmp_logo_stripe.svg"
                    factoryClass="ru.kazantsev.nsmp.sdk.intellij_plugin.ui.tool_window.main.MainToolWindowFactory"
                    canCloseContents="false"/>
        <toolWindow id="NSMP SDK Diff Manager"
                    anchor="bottom"
                    icon="/icons/logo/stripe_crossed/nsmp_logo_stripe_crossed.svg"
                    factoryClass="ru.kazantsev.nsmp.sdk.intellij_plugin.ui.tool_window.diff_manager.DiffManagerToolWindowFactory"
                    canCloseContents="false"/>
        <toolWindow id="NSMP SDK Meta Classes"
                    anchor="right"
                    icon="/icons/logo/stripe/nsmp_logo_stripe.svg"
                    factoryClass="ru.kazantsev.nsmp.sdk.intellij_plugin.ui.tool_window.metaclass.MetaClassToolWindowFactory"
                    canCloseContents="false"/>
        <projectConfigurable id="ru.kazantsev.nsmp.sdk.intellij_plugin.service.settings"
                             parentId="tools"
                             instance="ru.kazantsev.nsmp.sdk.intellij_plugin.ui.settings.PluginConfigurable"
                             displayName="NSMP SDK"/>
    </extensions>

    <extensions defaultExtensionNs="org.intellij.groovy">
        <variableEnhancer implementation="ru.kazantsev.nsmp.sdk.intellij_plugin.service.metaclass.binding.MetaClassVariableTypeEnhancer"/>
        <referenceTypeEnhancer implementation="ru.kazantsev.nsmp.sdk.intellij_plugin.service.metaclass.binding.MetaClassReferenceTypeEnhancer"/>
        <typeAugmenter implementation="ru.kazantsev.nsmp.sdk.intellij_plugin.service.metaclass.binding.MetaClassTypeAugmenter"/>
        <typeCalculator forClass="org.jetbrains.plugins.groovy.lang.psi.api.statements.expressions.GrReferenceExpression"
                        implementationClass="ru.kazantsev.nsmp.sdk.intellij_plugin.service.metaclass.binding.MetaClassReferenceTypeCalculator"
                        order="first"/>
        <membersContributor implementation="ru.kazantsev.nsmp.sdk.intellij_plugin.service.metaclass.binding.MetaClassMembersContributor"
                            order="last"/>
    </extensions>

    <projectListeners>
        <listener class="ru.kazantsev.nsmp.sdk.intellij_plugin.listener.top_panel.TopPanelFileEditorManagerListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

    <actions>
        <!--Actions for project -->
        <action id="NSMP.SDK.Project.OpenInstallation"
                class="ru.kazantsev.nsmp.sdk.intellij_plugin.actions.project.ProjectOpenInstallationAction"
                text="NSMP SDK: Open Installation"
                description="Open selected NSMP installation">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift O"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt shift O"/>
        </action>
        <action id="NSMP.SDK.Project.Pull"
                class="ru.kazantsev.nsmp.sdk.intellij_plugin.actions.project.ProjectPullAction"
                text="NSMP SDK: Pull Project Sources"
                description="Pull project sources from remote">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift P"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt shift P"/>
        </action>
        <action id="NSMP.SDK.Project.Push"
                class="ru.kazantsev.nsmp.sdk.intellij_plugin.actions.project.ProjectPushAction"
                text="NSMP SDK: Push Project Sources"
                description="Push project sources to remote">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift U"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt shift U"/>
        </action>
        <action id="NSMP.SDK.Project.SyncCheck"
                class="ru.kazantsev.nsmp.sdk.intellij_plugin.actions.project.ProjectSyncCheckAction"
                text="NSMP SDK: Check Project Sync"
                description="Check project synchronization state">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift C"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt shift C"/>
        </action>
        <action id="NSMP.SDK.Project.RemoteStateUpdate"
                class="ru.kazantsev.nsmp.sdk.intellij_plugin.actions.project.ProjectRemoteStateUpdateAction"
                text="NSMP SDK: Update Remote State"
                description="Update remote source state">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift R"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt shift R"/>
        </action>
        <action id="NSMP.SDK.Project.MetaClassSync"
                class="ru.kazantsev.nsmp.sdk.intellij_plugin.actions.project.ProjectMetaClassSyncAction"
                text="NSMP SDK: Sync Meta Classes"
                description="Fetch meta classes from installation and regenerate IDE stubs">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift M"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt shift M"/>
        </action>

        <!--Actions for files -->
        <action id="NSMP.SDK.File.OpenInBrowser"
                class="ru.kazantsev.nsmp.sdk.intellij_plugin.actions.project.file.FileOpenInBrowserAction"
                text="NSMP SDK: Open File In Browser"
                description="Open current source file in browser">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt O"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt O"/>
        </action>
        <action id="NSMP.SDK.File.Execute"
                class="ru.kazantsev.nsmp.sdk.intellij_plugin.actions.project.file.FileExecuteAction"
                text="NSMP SDK: Execute File"
                description="Execute current script file">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt E"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt E"/>
        </action>
        <action id="NSMP.SDK.File.Pull"
                class="ru.kazantsev.nsmp.sdk.intellij_plugin.actions.project.file.FilePullAction"
                text="NSMP SDK: Pull File"
                description="Pull current file from remote">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt P"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt P"/>
        </action>
        <action id="NSMP.SDK.File.Push"
                class="ru.kazantsev.nsmp.sdk.intellij_plugin.actions.project.file.FilePushAction"
                text="NSMP SDK: Push File"
                description="Push current file to remote">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt U"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt U"/>
        </action>
        <action id="NSMP.SDK.File.SyncCheck"
                class="ru.kazantsev.nsmp.sdk.intellij_plugin.actions.project.file.FileSyncCheckAction"
                text="NSMP SDK: Check File Sync"
                description="Check synchronization state for current file">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt C"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt C"/>
        </action>
    </actions>

</idea-plugin>
